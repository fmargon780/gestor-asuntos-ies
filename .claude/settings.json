{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Agent",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "mcp__github__*",
      "mcp__GitHub__*",
      "mcp__vercel__*",
      "mcp__Vercel__*",
      "mcp__supabase__*",
      "mcp__Supabase__*"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~ *)",
      "Bash(sudo rm *)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"$CLAUDE_PROJECT_DIR/scripts/aviso-esperando.sh\"; [ -x \"$S\" ] && \"$S\" esperando >/dev/null 2>&1; exit 0",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${TMPDIR:-/tmp}/aviso-esperando.flag\" ] || exit 0; S=\"$CLAUDE_PROJECT_DIR/scripts/aviso-esperando.sh\"; [ -x \"$S\" ] && \"$S\" libre >/dev/null 2>&1; exit 0",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${TMPDIR:-/tmp}/aviso-esperando.flag\" ] || exit 0; S=\"$CLAUDE_PROJECT_DIR/scripts/aviso-esperando.sh\"; [ -x \"$S\" ] && \"$S\" libre >/dev/null 2>&1; exit 0",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
